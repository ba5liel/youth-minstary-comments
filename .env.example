# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary reader. Use the strongest vision model available to you (a "pro" model if offered).
GEMINI_MODEL=gemini-4-argon
# Independent second reader; answers where the two disagree go to manual review. Empty = off.
VERIFY_MODEL=gemini-3.1-pro-preview
# "low" stops the verifier from thinking for minutes on messy handwriting.
GEMINI_THINKING=
VERIFY_THINKING=low
# Detects sideways photos before reading.
ORIENT_MODEL=gemini-3.5-flash
CONCURRENCY=4

# Triage thresholds (0-1). Raise them to send more to manual review, lower to send less.
# MIN_AGREEMENT=1.0 means the two readers must match exactly (ignoring punctuation/spacing/homophone letters):
# one wrong Fidel letter can change the meaning, so near-matches still go to review.
MIN_CONFIDENCE=0.85
MIN_AGREEMENT=1.0
MIN_LEGIBILITY=0.6
# Share of automatically-accepted sheets sent to review anyway, to measure real accuracy.
SPOT_CHECK_RATE=0.05

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids of reviewers (the bot tells each person their id).
ADMIN_IDS=
CLAIM_MINUTES=30

IMAGES_DIR=images
DB_PATH=data/feedback.db
