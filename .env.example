# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Primary reader. Use the strongest vision model available to you (a "pro" model if offered).
GEMINI_MODEL=gemini-3.5-flash
# Independent second reader; answers where the two disagree go to manual review. Empty = off.
VERIFY_MODEL=gemini-3.1-flash-lite
CONCURRENCY=4

# Triage thresholds (0-1). Raise them to send more to manual review, lower to send less.
MIN_CONFIDENCE=0.85
MIN_AGREEMENT=0.85
MIN_LEGIBILITY=0.6
# Share of automatically-accepted sheets sent to review anyway, to measure real accuracy.
SPOT_CHECK_RATE=0.05

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids of reviewers (the bot tells each person their id).
ADMIN_IDS=
CLAIM_MINUTES=30

IMAGES_DIR=images
DB_PATH=data/feedback.db
